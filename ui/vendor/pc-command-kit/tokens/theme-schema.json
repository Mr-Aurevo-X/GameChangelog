{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atelier-theme.json",
  "title": "Atelier / PC Command theme",
  "description": "Runtime theme applied by components/settings-panel.js applyTheme(). Canonical palette SoT: tokens/presets/*.json (regenerate PRESETS via scripts/Sync-PresetsIntoSettingsPanel.ps1). User file: %APPDATA%/Mr-Aurevo-X/atelier-theme.json.",
  "type": "object",
  "properties": {
    "preset": {
      "type": "string",
      "enum": ["pc-command", "soft-glass", "neon-precision", "graphite-minimal", "amber-ops", "custom"],
      "description": "Named preset id or custom when user overrides colors"
    },
    "bg": { "type": "string", "description": "CSS --bg" },
    "panel": { "type": "string", "description": "CSS --panel" },
    "panel2": { "type": "string", "description": "CSS --panel2" },
    "text": { "type": "string", "description": "CSS --text" },
    "muted": { "type": "string", "description": "CSS --muted" },
    "accent": { "type": "string", "description": "CSS --accent" },
    "cyan": { "type": "string", "description": "CSS --cyan" },
    "ok": { "type": "string", "description": "CSS --ok" },
    "warn": { "type": "string", "description": "CSS --warn" },
    "glowAccent": { "type": "string", "description": "Optional glow for accent" },
    "glowCyan": { "type": "string", "description": "Optional glow for cyan/telemetry" }
  },
  "required": ["preset"],
  "additionalProperties": true
}
